# Copy to dbt_project/.env, fill in your values, then:  source .env
# .env is gitignored (see ../.gitignore) — never commit real credentials.
#
# These map to the payments_ledger_analytics profile in ~/.dbt/profiles.yml
# (see profiles_example.yml). Defaults shown match that file's fallbacks.

export SNOWFLAKE_ACCOUNT="your_account_identifier"
export SNOWFLAKE_USER="your_user"

# externalbrowser (SSO) is the profile default. If your account isn't
# SSO-configured, override both of these instead:
# export SNOWFLAKE_AUTHENTICATOR="snowflake"
# export SNOWFLAKE_PASSWORD="your_password"

export SNOWFLAKE_ROLE="DBT_TRANSFORMER"
export SNOWFLAKE_DATABASE="PAYMENTS_LEDGER"
export SNOWFLAKE_WAREHOUSE="WH_DBT_TRANSFORM"
export SNOWFLAKE_SCHEMA="dev_yourname"          # personal dev schema, e.g. dev_priya
# NOTE: the `dev` target auto-creates a per-developer schema, which needs
# CREATE SCHEMA on the database. snowflake/01_grants.sql deliberately does NOT
# grant that to DBT_TRANSFORMER (see README §3), so either grant it, or use
# `--target ci`, whose schemas 00_setup_database_warehouse.sql already creates.

# Read by the dbt Power User VS Code extension (via python.envFile in .vscode/settings.json)
# so it finds ~/.dbt/profiles.yml the same way the CLI does by default.
export DBT_PROFILES_DIR="$HOME/.dbt"
